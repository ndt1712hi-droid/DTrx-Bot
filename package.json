{
  "name": "ziplayer-discord-bot",
  "version": "1.1.0",
  "type": "module",
  "description": "Lightweight, full-featured Discord Music Bot powered by ZiPlayer — optimized for Botkeep Free Tier & VPS",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node lib/index.js",
    "dev": "tsc --watch",
    "deploy": "node lib/deploy-commands.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test lib/tests/*.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@ziplayer/extension": "^1.0.1",
    "@ziplayer/plugin": "^1.0.2",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "ziplayer": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "ffmpeg-static": true
  }
}
