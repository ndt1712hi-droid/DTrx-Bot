# ============================================================================
# CẤU HÌNH BẮT BUỘC (REQUIRED DISCORD CREDENTIALS)
# ============================================================================
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# (Tùy chọn) Điền ID Server test nếu muốn cập nhật Slash Commands tức thì cho 1 server.
# Để trống nếu muốn đăng ký Slash Commands toàn cục (Global) cho mọi server.
DISCORD_GUILD_ID=

# ============================================================================
# CẤU HÌNH BOT & PHÁT NHẠC (BOT & PLAYBACK SETTINGS)
# ============================================================================
# Tiền tố lệnh chat văn bản (ví dụ: !play, !skip, !filter)
BOT_PREFIX=!

# Tự động đăng ký Slash Commands khi bot khởi động (true / false)
AUTO_DEPLOY_COMMANDS=true

# Âm lượng mặc định khi tạo trình phát (0 - 100)
DEFAULT_VOLUME=80

# Tự động rời kênh thoại khi hết hàng đợi / phòng trống
LEAVE_ON_END=true
LEAVE_ON_EMPTY=true
LEAVE_TIMEOUT_MS=60000

# Chế độ tiết kiệm RAM/CPU tối ưu cho gói Free (botkeep.cloud, Render...):
# Mặc định bật (true) để tắt Preload kép & Crossfade kép, giảm ~50% RAM/CPU.
# Nếu chạy VPS khỏe có thể đổi thành false để bật Crossfade mượt giữa 2 bài.
LOW_PERFORMANCE=true

# Thời lượng chuyển bài mượt Crossfade (ms) & Timeout tải luồng nhạc (ms)
CROSSFADE_DURATION_MS=4000
EXTRACTOR_TIMEOUT_MS=35000

# Lưu & khôi phục phiên phát nhạc khi bot khởi động lại
ENABLE_PERSISTENCE=true
PERSISTENCE_FILE=./data/sessions.json
# Phòng 24/7 được lưu độc lập trong voice-24-7.json cùng thư mục PERSISTENCE_FILE.
# Host phải giữ thư mục dữ liệu này qua restart/redeploy để bot tự vào lại phòng.
# Trả lời tự động được cấu hình bằng /autoreply và lưu trong auto-replies.json cùng thư mục.
# Cần bật Message Content Intent trong Discord Developer Portal để đọc tin nhắn thường.

# Giới hạn thời lượng tối đa khi xuất file MP3 qua lệnh /save (giây)
MAX_SAVE_DURATION_SEC=300

# ============================================================================
# TÍNH NĂNG MỞ RỘNG ZIPLAYER (PLUGINS & EXTENSIONS)
# ============================================================================
# Ngôn ngữ mặc định cho Text-To-Speech (tts: xin chào)
TTS_LANG=vi
TTS_MAX_TIME_MS=60000

# Tự động tìm lời bài hát (LRCLIB / Lyrics.ovh) & hiển thị Karaoke đồng bộ
ENABLE_LYRICS=true
AUTO_LIVE_LYRICS=false

# Điều khiển bằng giọng nói trong kênh thoại (Speech-to-Text - voiceExt)
# Lưu ý: Khi bật tính năng này, bot sẽ tự bỏ selfDeaf để nghe giọng nói.
ENABLE_VOICE_COMMANDS=false
VOICE_LANG=vi-VN
VOICE_WAKE_WORDS=zi,bot

# (Tùy chọn) Gemini API Key để kích hoạt AiAutoplayExtension (gợi ý nhạc thông minh bằng AI)
GEMINI_API_KEY=

# (Tùy chọn) Danh sách Lavalink Nodes (định dạng host:port:password:secure phân tách dấu phẩy, hoặc JSON)
# Ví dụ: localhost:2333:youshallnotpass:false
LAVALINK_NODES=

# Mức log debug của ZiPlayer (off | error | warn | info | debug | trace | time)
ZIPLAYER_DEBUG_LEVEL=off
