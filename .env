# ============================================================================\n# CẤU HÌNH BẮT BUỘC (REQUIRED DISCORD CREDENTIALS)\n# ============================================================================\nDISCORD_TOKEN=YOUR_TOKEN_HERE\nDISCORD_CLIENT_ID=YOUR_CLIENT_ID_HERE\n\n# (Tùy chọn) Điền ID Server test nếu muốn cập nhật Slash Commands tức thì cho 1 server.\n# Để trống nếu muốn đăng ký Slash Commands toàn cục (Global) cho mọi server.\nDISCORD_GUILD_ID=\n\n# ============================================================================\n# CẤU HÌNH BOT & PHÁT NHẠC (BOT & PLAYBACK SETTINGS)\n# ============================================================================\n# Tiền tố lệnh chat văn bản (ví dụ: !play, !skip, !filter)\nBOT_PREFIX=!\n\n# Tự động đăng ký Slash Commands khi bot khởi động (true / false)\nAUTO_DEPLOY_COMMANDS=true\n\n# Âm lượng mặc định khi tạo trình phát (0 - 100)\nDEFAULT_VOLUME=80\n\n# Tự động rời kênh thoại khi hết hàng đợi / phòng trống\nLEAVE_ON_END=true\nLEAVE_ON_EMPTY=true\nLEAVE_TIMEOUT_MS=60000\n\n# Chế độ tiết kiệm RAM/CPU tối ưu cho gói Free (botkeep.cloud, Render...):\n# Mặc định bật (true) để tắt Preload kép & Crossfade kép, giảm ~50% RAM/CPU.\n# Nếu chạy VPS khỏe có thể đổi thành false để bật Crossfade mượt giữa 2 bài.\nLOW_PERFORMANCE=true\n\n# Thời lượng chuyển bài mượt Crossfade (ms) & Timeout tải luồng nhạc (ms)\nCROSSFADE_DURATION_MS=4000\nEXTRACTOR_TIMEOUT_MS=35000\n\n# Lưu & khôi phục phiên phát nhạc khi bot khởi động lại\nENABLE_PERSISTENCE=true\nPERSISTENCE_FILE=./data/sessions.json\n# Phòng 24/7 được lưu độc lập trong voice-24-7.json cùng thư mục PERSISTENCE_FILE.\n# Host phải giữ thư mục dữ liệu này qua restart/redeploy để bot tự vào lại phòng.\n# Trả lời tự động được cấu hình bằng /autoreply và lưu trong auto-replies.json cùng thư mục.\n# Cần bật Message Content Intent trong Discord Developer Portal để đọc tin nhắn thường.\n# /welcome và /goodbye lưu trong member-greetings.json cùng thư mục.\n# Ảnh nền tự tải qua /welcome banner và /goodbye banner lưu trong member-banners/.\n# Cần bật Server Members Intent trong Developer Portal để nhận sự kiện vào/rời.\n# /lock và /unlock lưu quyền gốc trong channel-locks.json cùng thư mục; giữ file này khi cập nhật.\n# /spam lưu cấu hình và tin bot trong mention-reminders.json; các đợt tag không tự chạy sau restart.\n\n# Giới hạn thời lượng tối đa khi xuất file MP3 qua lệnh /save (giây)\nMAX_SAVE_DURATION_SEC=300\n\n# ============================================================================\n# TÍNH NĂNG MỞ RỘNG ZIPLAYER (PLUGINS & EXTENSIONS)\n# ============================================================================\n# Ngôn ngữ mặc định cho Text-To-Speech (tts: xin chào)\nTTS_LANG=vi\nTTS_MAX_TIME_MS=60000\n\n# Tự động tìm lời bài hát (LRCLIB / Lyrics.ovh) & hiển thị Karaoke đồng bộ\nENABLE_LYRICS=true\nAUTO_LIVE_LYRICS=false\n\n# Điều khiển bằng giọng nói trong kênh thoại (Speech-to-Text - voiceExt)\n# Lưu ý: Khi bật tính năng này, bot sẽ tự bỏ selfDeaf để nghe giọng nói.\nENABLE_VOICE_COMMANDS=false\nVOICE_LANG=vi-VN\nVOICE_WAKE_WORDS=zi,bot\n\n# (Tùy chọn) Gemini API Key để kích hoạt AiAutoplayExtension (gợi ý nhạc thông minh bằng AI)\nGEMINI_API_KEY=\n\n# (Tùy chọn) Danh sách Lavalink Nodes (định dạng host:port:password:secure phân tách dấu phẩy, hoặc JSON)\n# Ví dụ: localhost:2333:youshallnotpass:false\nLAVALINK_NODES=\n\n# Mức log debug của ZiPlayer (off | error | warn | info | debug | trace | time)\nZIPLAYER_DEBUG_LEVEL=off\n